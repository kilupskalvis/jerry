#!/bin/sh
#
# Pre-commit hook for Jerry.
# Runs formatting checks, vet, and lint on staged Go files.
# Install: copy to .git/hooks/pre-commit (done automatically by the repo).

set -e

# Only check staged Go files.
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
    exit 0
fi

echo "pre-commit: checking staged Go files..."

# 1. Check formatting with gofmt.
UNFORMATTED=$(gofmt -l $STAGED_GO_FILES 2>/dev/null || true)
if [ -n "$UNFORMATTED" ]; then
    echo "pre-commit: the following files are not gofmt'd:"
    echo "$UNFORMATTED"
    echo ""
    echo "Run: gofmt -w \$(git diff --cached --name-only --diff-filter=ACM | grep '\\.go\$')"
    exit 1
fi

# 2. Run go vet.
echo "pre-commit: go vet..."
go vet ./...
if [ $? -ne 0 ]; then
    echo "pre-commit: go vet failed"
    exit 1
fi

# 3. Run golangci-lint if available.
if command -v golangci-lint >/dev/null 2>&1; then
    echo "pre-commit: golangci-lint..."
    golangci-lint run --new-from-rev=HEAD ./...
    if [ $? -ne 0 ]; then
        echo "pre-commit: golangci-lint found issues"
        exit 1
    fi
fi

# 4. Run deadcode if available.
if command -v deadcode >/dev/null 2>&1; then
    echo "pre-commit: deadcode..."
    DEAD=$(deadcode -test ./... 2>/dev/null || true)
    if [ -n "$DEAD" ]; then
        echo "pre-commit: dead code detected:"
        echo "$DEAD"
        exit 1
    fi
fi

# 5. Run tests.
echo "pre-commit: go test..."
go test ./... -timeout 120s
if [ $? -ne 0 ]; then
    echo "pre-commit: tests failed"
    exit 1
fi

echo "pre-commit: all checks passed"
